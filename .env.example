# Örnek ortam değişkenleri dosyası
# KULLANIM: Bu dosyayı .env olarak kopyalayın ve gerçek değerleri .env içine yazın.
# ASLA .env dosyasını Git'e eklemeyin (bkz: .gitignore)

# Uygulama
APP_NAME=OrnekUygulama
APP_PORT=3000

# Veritabanı
DATABASE_URL=sqlite:///./veritabani.db

# API anahtarlari (ornedekiler sahte degerlerdir)
API_KEY=degistirin_bu_degeri
SECRET_KEY=degistirin_bu_degeri

# Yapay zeka modeli
MODEL_SAGLAYICI=acik_veya_yerel
MODEL_ADI=llama3
